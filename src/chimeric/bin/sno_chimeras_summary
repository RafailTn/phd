#!/usr/bin/env bash
# Generated wrapper: sno-chimeras.py invokes its helper scripts as bare command
# names, and config.sh puts this directory on PATH. Self-locating so a checkout
# works at any path -- these used to hardcode one workstation's absolute paths.
_d=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
exec "${PYTHON:-python3}" "$_d/../scripts/sno_chimeras_summary.py" "$@"
